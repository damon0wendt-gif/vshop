# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Site ──────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used for OAuth redirects).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Your Discord community invite.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-server

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to NEXT_PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── Roblox OAuth (official "Login with Roblox") ──────────────────────────
# Create an app at https://create.roblox.com/dashboard/credentials (OAuth2).
# While these are unset, the site runs in a clearly-labeled demo login mode.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Optional — defaults to NEXT_PUBLIC_BASE_URL + /api/auth/roblox/callback
ROBLOX_REDIRECT_URI=

# ── Admin access ──────────────────────────────────────────────────────────
# Comma-separated Roblox user IDs that get admin dashboard access on login.
# Roblox OAuth never shares user emails — real-account admin rights bind to
# your Roblox User ID, not an email address.
ADMIN_ROBLOX_IDS=
# Admin emails for the (demo) owner account. Only these addresses may claim
# the owner identity that manages products/bundles. Defaults to the owner.
ADMIN_EMAILS=damon0wendt@gmail.com

# ── Demo login ────────────────────────────────────────────────────────────
# Demo login auto-disables once ROBLOX_CLIENT_ID/SECRET are set.
# Set to "true" to explicitly allow demo login alongside real OAuth.
ALLOW_DEMO_LOGIN=false
